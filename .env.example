ROBOROCK_EMAIL=your_email@example.com

# Optional: set this and the server can log in on its own (bootstrapping
# .cache/credentials.json if missing, and re-logging in automatically if the
# cached token ever stops working) instead of needing 'python auth.py' rerun
# by hand. Only works if your Roborock account has a password set.
# ROBOROCK_PASSWORD=your_password

# Only needed if you have more than one vacuum on your account:
# ROBOROCK_DEVICE_NAME=Rocky
# ROBOROCK_DEVICE_MODEL=roborock.vacuum.a170
